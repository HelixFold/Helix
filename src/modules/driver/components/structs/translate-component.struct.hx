/**
 * Imports
 */

import * as fmt from "std/fmt";
import { ArrayList } from "std/list";
import * as sys from "@modules/driver/bindings/sys.binding";
import { Strings } from "@modules/driver/components/structs/os-component.struct";

/**
 * The options of a `helix translate-c` run.
 *
 * @remarks
 * By default the run translates the input header,
 * and the headers that it includes directly from its own folder or below.
 * `wholeDir` takes every header under that folder, and `all` takes everything that clang saw.
 *
 * @example
 * ```hx
 * const options = TranslateOptions {
 *     header: "zlib.h", output: "src/zlib.hx", triple: null, clangArgs, all: false, wholeDir: false,
 *     command: "helix translate-c zlib.h -o src/zlib.hx",
 * };
 * translateC(options); // 0
 * ```
 *
 * @see translateC
 * @since 1.0.0
 */

export struct TranslateOptions {
    /**
     * The C header to read.
     *
     * @example
     * ```hx
     * options.header; // "include/zlib.h"
     * ```
     *
     * @since 1.0.0
     */

    header: string,

    /**
     * The Helix file to write, or `null` for standard output.
     *
     * @example
     * ```hx
     * options.output; // "src/zlib.hx"
     * ```
     *
     * @since 1.0.0
     */

    output: ?string,

    /**
     * The LLVM triple of the target, or `null` for the host.
     *
     * @remarks
     * The target decides the sizes of C types such as `long`.
     *
     * @example
     * ```hx
     * options.triple; // "x86_64-unknown-linux-musl"
     * ```
     *
     * @since 1.0.0
     */

    triple: ?string,

    /**
     * The options that clang gets after those of Helix, such as `-I`, `-D`, and `-isystem`.
     *
     * @example
     * ```hx
     * options.clangArgs; // [ "-Ivendor/include", "-DZLIB_CONST" ]
     * ```
     *
     * @since 1.0.0
     */

    clangArgs: readonly string[],

    /**
     * Whether to translate everything that clang saw, system headers too.
     *
     * @example
     * ```hx
     * options.all; // true for --all
     * ```
     *
     * @since 1.0.0
     */

    all: bool,

    /**
     * Whether to translate every header under the folder of the input, not just the ones that it includes directly.
     *
     * @example
     * ```hx
     * options.wholeDir; // true for --dir
     * ```
     *
     * @since 1.0.0
     */

    wholeDir: bool,

    /**
     * The command line, which the header comment of the output repeats.
     *
     * @example
     * ```hx
     * options.command; // "helix translate-c zlib.h -o src/zlib.hx"
     * ```
     *
     * @since 1.0.0
     */

    command: string,
}

/**
 * The state of one `helix translate-c` run.
 *
 * @remarks
 * The libclang visitors get a pointer to it, or to a walk that holds one, as their client data.
 *
 * @example
 * ```hx
 * const tc = contextOf(data); // in a visitor
 * tc.emitted;                 // the Helix names declared so far
 * ```
 *
 * @see translateC
 * @since 1.0.0
 */

export struct TranslateContext {
    /**
     * The translation unit that libclang parsed.
     *
     * @example
     * ```hx
     * sys.clang_getTranslationUnitCursor(tc.tu); // the root of the declarations
     * ```
     *
     * @since 1.0.0
     */

    tu: sys.CXTranslationUnit,

    /**
     * The folder of the input header, with symbolic links resolved.
     *
     * @example
     * ```hx
     * tc.ownDir; // "/home/me/zlib"
     * ```
     *
     * @since 1.0.0
     */

    ownDir: string,

    /**
     * The headers that the run translates, which are the input and what it includes directly from its own folder.
     *
     * @example
     * ```hx
     * tc.ownFiles; // [ "/home/me/zlib/zlib.h", "/home/me/zlib/zconf.h" ]
     * ```
     *
     * @since 1.0.0
     */

    ownFiles: Strings,

    /**
     * Whether every declaration that clang saw counts as its own.
     *
     * @example
     * ```hx
     * tc.all; // true for --all
     * ```
     *
     * @since 1.0.0
     */

    all: bool,

    /**
     * Whether every header under the `ownDir` folder counts as its own, as `--dir` asks.
     *
     * @example
     * ```hx
     * tc.wholeDir; // true for --dir
     * ```
     *
     * @since 1.0.0
     */

    wholeDir: bool,

    /**
     * The Helix text written so far.
     *
     * @remarks
     * A record swaps in a builder of its own while it walks its fields,
     * so the nested records that it writes land before it.
     *
     * @example
     * ```hx
     * tc.out.text(); // "// Generated by `helix translate-c zlib.h`. ..."
     * ```
     *
     * @since 1.0.0
     */

    out: fmt.Builder,

    /**
     * The Helix names already declared, which keeps each declaration to one.
     *
     * @example
     * ```hx
     * tc.emitted.items.len; // the number of declarations that the run reports
     * ```
     *
     * @since 1.0.0
     */

    emitted: Strings,

    /**
     * The names of the C functions and variables, which win a name clash with a struct tag.
     *
     * @remarks
     * The first walk over the declarations collects them,
     * so `struct stat` next to `int stat(...)` becomes `struct_stat`.
     *
     * @example
     * ```hx
     * tc.functionNames; // [ "stat", "deflate", ... ]
     * ```
     *
     * @since 1.0.0
     */

    functionNames: Strings,

    /**
     * The structs from other headers that the output uses, declared opaque at the end.
     *
     * @example
     * ```hx
     * tc.pendingOpaque; // [ "FILE" ]
     * ```
     *
     * @since 1.0.0
     */

    pendingOpaque: Strings,

    /**
     * The structs of these headers that the output uses and the top-level walk cannot see.
     *
     * @remarks
     * A struct defined inside another struct is one of them.
     * Each one is written at the end, unless the run already wrote it.
     *
     * @example
     * ```hx
     * tc.pending.items.len; // 1 for a struct defined inside another one
     * ```
     *
     * @since 1.0.0
     */

    pending: ArrayList<sys.CXCursor>,

    /**
     * The number of declarations left out as comments.
     *
     * @example
     * ```hx
     * tc.skipped; // 2 for two `static inline` functions
     * ```
     *
     * @since 1.0.0
     */

    skipped: u32,

    /**
     * The number of `_anon<n>` names given to unnamed records so far.
     *
     * @example
     * ```hx
     * tc.anonymous; // 1 after `_anon0`
     * ```
     *
     * @since 1.0.0
     */

    anonymous: u32,
}

/**
 * The C argument array that `clang_parseTranslationUnit2` takes.
 *
 * @example
 * ```hx
 * const argv: CArgv = readonlyArgs(cArgs(args.items));
 * ```
 *
 * @since 1.0.0
 */

export type CArgv = ?readonly (?readonly u8[*])[*];

/**
 * The state of the walk over the fields of one struct.
 *
 * @remarks
 * {@link emitRecord} creates one for each struct, and {@link visitField} fills it field by field.
 * A field that Helix cannot express clears `ok` and sets `why`, so the struct falls back to its size and alignment.
 *
 * @example
 * ```hx
 * let walk = FieldWalk { tc, fields: fmt.Builder.init(cAllocator()), why: "", ok: true, anon: 0, owner: name };
 * ```
 *
 * @see visitField
 * @since 1.0.0
 */

export struct FieldWalk {
    /**
     * The state of the run.
     *
     * @example
     * ```hx
     * walk.tc; // the Tc of the run
     * ```
     *
     * @since 1.0.0
     */

    tc: *TranslateContext,

    /**
     * The Helix text of the fields so far, one line each.
     *
     * @example
     * ```hx
     * walk.fields.text(); // "    x: i32,\n    y: i32,\n"
     * ```
     *
     * @since 1.0.0
     */

    fields: fmt.Builder,

    /**
     * The reason that the struct cannot keep its fields, or an empty string.
     *
     * @example
     * ```hx
     * walk.why; // "bit fields"
     * ```
     *
     * @since 1.0.0
     */

    why: string,

    /**
     * Whether every field so far has a Helix type.
     *
     * @example
     * ```hx
     * walk.ok; // false after a bit field
     * ```
     *
     * @since 1.0.0
     */

    ok: bool,

    /**
     * The number of unnamed members given an `_anon<n>` name so far.
     *
     * @example
     * ```hx
     * walk.anon; // 1 after `_anon0`
     * ```
     *
     * @since 1.0.0
     */

    anon: u32,

    /**
     * The Helix name of the struct, which names its anonymous nested structs.
     *
     * @example
     * ```hx
     * walk.owner; // "outer", so its `struct { ... } in` becomes `outer_in`
     * ```
     *
     * @since 1.0.0
     */

    owner: string,
}

/**
 * The state of the walk over the members of one enum.
 *
 * @remarks
 * {@link emitEnumConstants} creates one for each enum and passes it to {@link visitConstant} as client data.
 *
 * @example
 * ```hx
 * let walk = EnumWalk { tc, type: "color", signed: false };
 * ```
 *
 * @see visitConstant
 * @since 1.0.0
 */

export struct EnumWalk {
    /**
     * The state of the run.
     *
     * @example
     * ```hx
     * walk.tc; // the Tc of the run
     * ```
     *
     * @since 1.0.0
     */

    tc: *TranslateContext,

    /**
     * The Helix type of the constants, the enum alias or its integer type.
     *
     * @example
     * ```hx
     * walk.type; // "color"
     * ```
     *
     * @since 1.0.0
     */

    type: string,

    /**
     * Whether the integer type of the enum is signed, which decides how the values are read.
     *
     * @example
     * ```hx
     * walk.signed; // true for an enum with a negative member
     * ```
     *
     * @since 1.0.0
     */

    signed: bool,
}

/**
 * The state of a walk over the top-level declarations.
 *
 * @remarks
 * {@link translateC} makes two passes with one walk.
 * The first only collects the names of functions and variables, so that a tag with the same name gets `struct_`.
 * The second writes the declarations.
 *
 * @example
 * ```hx
 * let pass = TopWalk { tc: &tc, functionsOnly: true };
 * ```
 *
 * @see visitTop
 * @since 1.0.0
 */

export struct TopWalk {
    /**
     * The state of the run.
     *
     * @example
     * ```hx
     * pass.tc; // a pointer to the Tc of the run
     * ```
     *
     * @since 1.0.0
     */

    tc: *TranslateContext,

    /**
     * Whether this walk only collects the names of functions and variables, as the first pass does.
     *
     * @example
     * ```hx
     * pass.functionsOnly; // false in the second pass, which writes the declarations
     * ```
     *
     * @since 1.0.0
     */

    functionsOnly: bool,
}
