/**
 * Imports
 */

import * as fmt from "std/fmt";
import { cAllocator } from "std";
import { tempDir, readText, writeText } from "@modules/driver/components/os.component";
import { translateSvd, cmdTranslateSvd } from "@modules/driver/components/svd.component";

/**
 * Tests
 */

/**
 * A text built from a template, on the C heap.
 *
 * @param template - The template to format
 * @returns The formatted text
 *
 * @remarks
 * An allocation failure is unreachable in a spec, so the result needs no error handling.
 *
 * @since 1.0.0
 */

function text(template: Format): string {
    return fmt.alloc(cAllocator(), template) catch unreachable;
}

/**
 * A small SVD file: a Cortex-M4 with two GPIO ports that share registers and two interrupts.
 *
 * @returns The SVD text
 *
 * @remarks
 * It covers each way that SVD writes a field and a number, a `dim` register, `derivedFrom`, an entity, and a comment,
 * so one translation exercises most of the reader.
 *
 * @since 1.0.0
 */

function chip(): string {
    return text(`<?xml version="1.0"?><!-- a comment -->
<device><name>CHIP1</name><description>A &lt;test&gt; chip</description><cpu><name>CM4</name></cpu><size>32</size>
<peripherals>
<peripheral><name>GPIOA</name><description>General   purpose
 IO</description><baseAddress>0x40020000</baseAddress><registers>
<register><name>MODER</name><description>Mode</description><addressOffset>0x0</addressOffset><fields>
<field><name>MODER0</name><description>Pin 0</description><bitOffset>0</bitOffset><bitWidth>2</bitWidth></field>
<field><name>type</name><bitRange>[7:4]</bitRange></field>
<field><name>EN</name><lsb>#1000</lsb><msb>8</msb></field>
</fields></register>
<register><name>CR%s</name><dim>2</dim><dimIncrement>4</dimIncrement><addressOffset>0x10</addressOffset><size>16</size></register>
</registers><interrupt><name>TIM2</name><description>Timer 2</description><value>28</value></interrupt></peripheral>
<peripheral derivedFrom="GPIOA"><name>GPIOB</name><baseAddress>0x40020400</baseAddress>
<interrupt><name>EXTI0</name><value>6</value></interrupt></peripheral>
</peripherals></device>`);
}

/**
 * The module that translating the small chip gives, or the error text when it fails.
 *
 * @returns The Helix module, or the error when the translation fails
 *
 * @remarks
 * Returning the error instead of `null` lets an expectation on the text show why a translation failed.
 *
 * @since 1.0.0
 */

function translated(): string {
    let error = "";
    return translateSvd(chip(), "chip.svd", &error) ?? error;
}

describe("translateSvd") {
    test("should name the source file and the chip in the header comment") {
        expect(translated()).toStartWith("// Generated by `helix translate-svd chip.svd`: the CHIP1 (A <test> chip).\n");
    }

    test("should suggest the cpu for helix.jsonc from the SVD cpu name") {
        expect(translated()).toInclude("\"cpu\": \"cortex-m4\"");
    }

    test("should import only the register types that the chip uses") {
        expect(translated()).toInclude("import { Register, Register16, nvicEnable } from \"std/mmio\";\n");
    }

    test("should write each field as its lowest bit and its width shifted by 8") {
        const module = translated();

        expect(module).toInclude("export enum GpioaModer: u32 {\n");
        expect(module).toInclude("    MODER0 = 0x0200,   // bits 0-1\n");
        expect(module).toInclude("    EN = 0x0108,   // bit 8\n");
    }

    test("should read a bit range and give a keyword member a trailing underscore") {
        expect(translated()).toInclude("    type_ = 0x0404,   // bits 4-7\n");
    }

    test("should keep descriptions as doc comments with entities decoded and white space joined") {
        const module = translated();

        expect(module).toInclude("/** General purpose IO */\nexport struct Gpioa {\n");
        expect(module).toInclude("    /** Pin 0 */\n");
    }

    test("should spell out a register array with its offsets") {
        const module = translated();

        expect(module).toInclude("    CR0: Register16<GpioaCr0>,   // +0x0010\n");
        expect(module).toInclude("    CR1: Register16<GpioaCr1>,   // +0x0014\n");
    }

    test("should give a register without fields one member for the whole register") {
        expect(translated()).toInclude("export enum GpioaCr0: u32 {\n    VALUE = 0x1000,   // the whole register\n}");
    }

    test("should let a derived peripheral share the type of its base") {
        const module = translated();

        expect(module).toInclude("/* ---- GPIOA, GPIOB ---- */");
        expect(module).toInclude("export const GPIOB: Gpioa = Gpioa {\n    MODER: Register<GpioaModer> { address: 0x4002_0400 },");
    }

    test("should list the interrupts by number") {
        expect(translated()).toInclude("    EXTI0 = 6,   // IRQ6_Handler\n    /** Timer 2 */\n    TIM2 = 28,   // IRQ28_Handler\n");
    }

    test("should show the lowest interrupt in the usage example") {
        expect(translated()).toInclude("//   enableInterrupt(Interrupt.EXTI0);");
    }

    test("should report a tag that is never closed") {
        let error = "";

        expect(translateSvd(text(`<device><name>X</name>`), "x.svd", &error)).toBeNull();
        expect(error).toBe("<device> is never closed");
    }

    test("should report a closing tag without an opening one") {
        let error = "";

        expect(translateSvd(text(`</device>`), "x.svd", &error)).toBeNull();
        expect(error).toBe("a closing tag without an opening one at byte 0");
    }

    test("should reject XML without a device") {
        let error = "";

        expect(translateSvd(text(`<chip></chip>`), "x.svd", &error)).toBeNull();
        expect(error).toBe("not an SVD file: no <device>");
    }

    test("should reject a device without peripherals") {
        let error = "";

        expect(translateSvd(text(`<device><name>X</name></device>`), "x.svd", &error)).toBeNull();
        expect(error).toBe("the SVD file has no <peripherals>");
    }
}

describe("cmdTranslateSvd") {
    test("should fail without an input file") {
        const args: string[0] = [];

        expect(cmdTranslateSvd(&args)).toBe(1);
    }

    test("should fail on an unexpected option") {
        const args: string[1] = ["--chip"];

        expect(cmdTranslateSvd(&args)).toBe(1);
    }

    test("should fail on a file that cannot be read") {
        const args: string[1] = ["/nonexistent/helix-spec/chip.svd"];

        expect(cmdTranslateSvd(&args)).toBe(1);
    }

    test("should write the translated module to the -o file") {
        const input = text(`${tempDir()}/helix-svd-spec.svd`);
        const output = text(`${tempDir()}/helix-svd-spec.hx`);
        void writeText(input, chip());
        const args: string[3] = [input, "-o", output];

        expect(cmdTranslateSvd(&args)).toBe(0);
        expect(readText(output) ?? "").toStartWith("// Generated by `helix translate-svd helix-svd-spec.svd`");
    }
}
