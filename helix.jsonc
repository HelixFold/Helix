{
    "name": "helix",
    "helix": ">=1.0.0-alpha.0",
    "version": "1.0.0-alpha.0",
    "license": "MIT",
    "description": "The Helix compiler",
    "c": {
        "sources": ["src/modules/driver/bindings/host.c", "src/modules/driver/bindings/lld.c"],
        "systemLibraries": ["LLVM", "clang", "lldCommon", "lldELF", "lldMachO", "lldCOFF", "lldMinGW", "lldWasm"]
    },
    "aliases": {
        "@models": "src/models",
        "@structs": "src/structs",
        "@modules": "src/modules",
        "@services": "src/services",
        "@constants": "src/constants",
        "@components": "src/components"
    }
}
