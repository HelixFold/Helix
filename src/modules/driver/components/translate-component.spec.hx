/**
 * Imports
 */

import * as fmt from "std/fmt";
import { cAllocator } from "std";
import { macosSdk } from "@modules/driver/components/libc.component";
import { translateC } from "@modules/driver/components/translate.component";
import { TranslateOptions } from "@modules/driver/components/structs/translate-component.struct";
import { tempDir, readText, writeText, makeDirs, exists } from "@modules/driver/components/os.component";

/**
 * Tests
 */

const NoArgs: readonly string[] = [];

/**
 * A text built from a template, on the C heap.
 *
 * @param template - The template to format
 * @returns The formatted text
 *
 * @remarks
 * An allocation failure is unreachable in a spec, so the result needs no error handling.
 *
 * @since 1.0.0
 */

function text(template: Format): string {
    return fmt.alloc(cAllocator(), template) catch unreachable;
}

/**
 * Whether this machine has the C library headers, such as `stdio.h`.
 *
 * @returns `true` on a Mac with an SDK, or elsewhere when `/usr/include/stdio.h` exists
 *
 * @remarks
 * Off a Mac the translator reads the headers of the host, never those of a macOS SDK that `SDKROOT` names,
 * and a bare container has none, so the case that includes `stdio.h` runs only where they exist.
 *
 * @since 1.0.0
 */

function hasSystemHeaders(): bool {
    if (exists("/System/Library/CoreServices/SystemVersion.plist")) return macosSdk() != null;
    return exists("/usr/include/stdio.h");
}

/**
 * A header with one of each kind of declaration, and some that Helix cannot express.
 *
 * @returns The C text of the header
 *
 * @remarks
 * Each line exercises one path of the translator, from records and enums to macros and the declarations that it skips.
 *
 * @since 1.0.0
 */

function sampleHeader(): string {
    return text(`#include <stddef.h>
#include <stdint.h>
/** Adds two numbers. */
int add(int a, int b);
size_t len(const char *s, ...);
struct point { int x, y; };
struct handle;
struct handle *open_handle(void);
union u { int i; float f; };
struct flags { unsigned a : 1; };
typedef unsigned int uInt;
typedef int (*cb)(int);
extern int count;
extern const int limit;
enum color { RED, GREEN = 5 };
#define VERSION "1.2"
#define MAX 0x10u
#define NEG (-3)
#define OCT 017
#define PI 3.5f
#define CH 'a'
static int hidden(void);
long double ld(void);
int type(int);
void old();
uint32_t u32v(uint64_t v, double xs[3]);
typedef struct { int a; } anon_t;
struct outer { struct { int b; } in; };
`);
}

/**
 * The folder that the specs write their headers into.
 *
 * @returns The path of the folder
 *
 * @remarks
 * It also writes `dep.h` and `sub/deep.h`, so a case can include them to test which headers count as its own.
 *
 * @since 1.0.0
 */

function folder(): string {
    const dir = text(`${tempDir()}/helix-translate-spec`);
    void makeDirs(text(`${dir}/sub`));
    void writeText(text(`${dir}/dep.h`), "#include \"sub/deep.h\"\nint dep(void);\n");
    void writeText(text(`${dir}/sub/deep.h`), "int deep(void);\n");
    return dir;
}

/**
 * The options for translating `main.h` of the spec folder into `main.hx`.
 *
 * @param source - The C text of `main.h`
 * @returns The options, without extra clang arguments and with `all` and `wholeDir` off
 *
 * @remarks
 * The header is written before the options are made, so the translation can run right away.
 *
 * @since 1.0.0
 */

function options(source: string): TranslateOptions {
    const dir = folder();
    const header = text(`${dir}/main.h`);
    void writeText(header, source);
    return TranslateOptions {
        header, output: text(`${dir}/main.hx`), triple: null, clangArgs: NoArgs, all: false, wholeDir: false,
        command: "helix translate-c main.h",
    };
}

/**
 * The Helix file that translating a header gives, or `failed` when the translation fails.
 *
 * @param opts - The options of the translation
 * @returns The text of the output file, or `failed` when the translation fails
 *
 * @remarks
 * Returning `failed` instead of an empty text lets an expectation show that the translation did not run to the end.
 *
 * @since 1.0.0
 */

function translated(opts: TranslateOptions): string {
    if (translateC(opts) != 0) return "failed";
    return readText(opts.output ?? "") ?? "";
}

/**
 * The Helix file that translating a header with the default options gives.
 *
 * @param source - The C text of the header
 * @returns The Helix file, or `failed`
 *
 * @remarks
 * It is the short form of {@link translated} and {@link options} that most cases use.
 *
 * @since 1.0.0
 */

function translate(source: string): string {
    return translated(options(source));
}

describe("translateC") {
    test("should open the file with the command that made it") {
        expect(translate("int f(void);\n")).toStartWith("// Generated by `helix translate-c main.h`.\n");
    }

    test("should declare a function with its doc comment and C types mapped to Helix") {
        const module = translate(sampleHeader());

        expect(module).toInclude("/** Adds two numbers. */\nexport extern \"C\" function add(a: i32, b: i32): i32;\n");
        expect(module).toInclude("export extern \"C\" function len(s: ?readonly u8[*], ...): usize;\n");
        expect(module).toInclude("export extern \"C\" function u32v(v: u64, xs: ?f64[*]): u32;\n");
    }

    test("should declare a struct with its fields") {
        expect(translate(sampleHeader())).toInclude("export extern \"C\" struct point {\n    x: i32,\n    y: i32,\n}\n");
    }

    test("should declare a struct without a definition as opaque") {
        const module = translate(sampleHeader());

        expect(module).toInclude("/** Opaque in C: use it only through pointers. */\nexport extern \"C\" struct handle {}\n");
        expect(module).toInclude("export extern \"C\" function open_handle(): ?*handle;\n");
    }

    test("should keep only the size and alignment of a union and of a struct with bit fields") {
        const module = translate(sampleHeader());

        expect(module).toInclude("only its size (4 bytes) and alignment (4) are kept. */\nexport extern \"C\" struct u {\n    _bytes: u32[1],\n}");
        expect(module).toInclude("/** C struct with bit fields: only its size (4 bytes) and alignment (4) are kept. */");
    }

    test("should name an unnamed struct after its typedef or the field that holds it") {
        const module = translate(sampleHeader());

        expect(module).toInclude("export extern \"C\" struct anon_t {\n    a: i32,\n}");
        expect(module).toInclude("export extern \"C\" struct outer_in {\n    b: i32,\n}");
        expect(module).toInclude("export extern \"C\" struct outer {\n    in: outer_in,\n}");
    }

    test("should declare typedefs, a function pointer type, and globals") {
        const module = translate(sampleHeader());

        expect(module).toInclude("export type uInt = u32;\n");
        expect(module).toInclude("export type cb = ?extern \"C\" (a0: i32) => i32;\n");
        expect(module).toInclude("export extern \"C\" let count: i32;\n");
        expect(module).toInclude("export extern \"C\" const limit: i32;\n");
    }

    test("should declare an enum as an integer type with a constant per member") {
        expect(translate(sampleHeader())).toInclude("export type color = u32;\nexport const RED: color = 0;\nexport const GREEN: color = 5;\n");
    }

    test("should turn literal macros into constants") {
        const module = translate(sampleHeader());

        expect(module).toInclude("export const VERSION = \"1.2\";\n");
        expect(module).toInclude("export const MAX = 0x10;\n");
        expect(module).toInclude("export const NEG = -3;\n");
        expect(module).toInclude("export const OCT = 0o17;\n");
        expect(module).toInclude("export const PI = 3.5;\n");
        expect(module).toInclude("export const CH = 97;\n");
    }

    test("should leave what Helix cannot express as a comment with the reason") {
        const module = translate(sampleHeader());

        expect(module).toInclude("// skipped function `hidden`: `static` and `inline` functions have no symbol to link to\n");
        expect(module).toInclude("// skipped function `ld`: `long double`, which Helix doesn't have\n");
        expect(module).toInclude("// skipped function `type`: its name is a Helix keyword\n");
        expect(module).toInclude("// skipped function `old`: it has no prototype (`int f()` rather than `int f(void)`)\n");
    }

    test("should declare a struct from a system header as opaque") {
        if (!hasSystemHeaders()) return;
        const module = translate("#include <stdio.h>\nvoid f(FILE *fp);\n");

        expect(module).toInclude("export extern \"C\" function f(fp: ?*FILE): void;\n");
        expect(module).toInclude("/** Opaque here (it's declared in another header): use it only through pointers. */\nexport extern \"C\" struct FILE {}");
        expect(module).not.toInclude("printf");
    }

    test("should translate the headers that the input includes directly from its own folder") {
        const module = translate("#include \"dep.h\"\nint own(void);\n");

        expect(module).toInclude("function own(): i32;");
        expect(module).toInclude("function dep(): i32;");
        expect(module).not.toInclude("function deep(): i32;");
    }

    test("should translate every header under the folder with wholeDir") {
        let opts = options("#include \"dep.h\"\nint own(void);\n");
        opts.wholeDir = true;

        expect(translated(opts)).toInclude("function deep(): i32;");
    }

    test("should size C integers for the target triple") {
        let opts = options("long f(void);\n");
        opts.triple = "i386-unknown-linux-gnu";

        expect(translated(opts)).toInclude("export extern \"C\" function f(): i32;");
    }

    test("should say so when the header declares nothing usable") {
        expect(translate("#define _PRIVATE 1\n")).toInclude("// (the header declares nothing Helix can use)\n");
    }

    test("should fail on a header that does not compile as C") {
        expect(translate("int f(void) oops;\n")).toBe("failed");
    }

    test("should fail on a header that cannot be read") {
        let opts = options("");
        opts.header = "/nonexistent/helix-translate-spec/missing.h";

        expect(translateC(opts)).toBe(1);
    }
}
